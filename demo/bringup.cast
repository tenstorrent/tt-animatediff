[75.049383, "o", "\u001b[?1049h\u001b[22;0;0t\u001b[>4;2m\u001b[?1h\u001b=\u001b[?2004h\u001b[?1004h\u001b[1;50r\u001b[?12h\u001b[?12l\u001b[22;2t\u001b[22;1t"]
[75.049542, "o", "\u001b[27m\u001b[23m\u001b[29m\u001b[m\u001b[H\u001b[2J\u001b[?25l\u001b[50;1H\"animatediff_ttnn/temporal_module.py\""]
[75.049634, "o", " [readonly] 97L, 3264B"]
[75.051176, "o", "\u001b[2;1H▽\u001b[6n\u001b[2;1H  \u001b[3;1H\u001bPzz\u001b\\\u001b[0%m\u001b[6n\u001b[3;1H           \u001b[1;1H\u001b[>c\u001b]10;?\u0007\u001b]11;?\u0007"]
[75.053479, "o", "\u001b[1;1H\u001b[93m 49 \u001b[m    b = bf // num_frames\r\n\u001b[93m 50 \u001b[m    h = weights.num_heads\u001b[2;30H\u001b[K\u001b[3;1H\u001b[93m 51 \u001b[m    hd = c // h\u001b[3;20H\u001b[K\u001b[4;1H\u001b[93m 52 \r\n 53 \u001b[m    \u001b[96m# (b*f, seq, c) →\u001b[5;26H (b*seq, f, c)\u001b[m\r\n\u001b[93m 54 \u001b[m    x = hidden_states.view(b, num_frames, seq, c)\r\n\u001b[93m 55 \u001b[m    x = x.permute(\u001b[95m0\u001b[m, \u001b[95m2\u001b[m, \u001b[95m1\u001b[m, \u001b[95m3\u001b[m).reshape(b * seq, num_frames, c)\r\n\u001b[93m 56 \r\n 57 \u001b[m    \u001b[96m# positional encoding\u001b[m\r\n\u001b[93m 58 \u001b[m    \u001b[93mif\u001b[m weights.pos_encoding \u001b[93mis\u001b[m \u001b[93mnot\u001b[m \u001b[1m\u001b[96mNone\u001b[m:\r\n\u001b[93m 59 \u001b[m\u001b[8Cx = x + weights.pos_encoding[:, :num_frames, :].to(x.device)\r\n\u001b[93m 60 \r\n 61 \u001b[m    F = torch.nn.functional\r\n\u001b[93m 62 \u001b[m    q = F.linear(x, weights.to_q_weight, weights.to_q_bias)\r\n\u001b[93m 63 \u001b[m    k = F.linear(x, weights.to_k_weight, weights.to_k_bias)\r\n\u001b[93m 64 \u001b[m    v = F.linear(x, weights.to_v_weight, weights.to_v_bias)\r\n\u001b[93m 65 \r\n 66 \u001b[m    \u001b[96m# multi-head: (b*seq, f, h, hd) →\u001b[18;42H (b*seq, h, f, hd)\u001b[m\r\n\u001b[93m 67 \u001b[m    \u001b[93mdef\u001b[m \u001b[1m\u001b[96msplit_heads\u001b[m(t):\r\n\u001b[93m 68 \u001b[m\u001b[8C\u001b[93mreturn\u001b[m t.view(b * seq, num_frames, h, hd).permute(\u001b[95m0\u001b[m, \u001b[95m2\u001b[m, \u001b[95m1\u001b[m, \u001b[95m3\u001b[m)\r\n\u001b[93m 69 \r\n 70 \u001b[m    q, k, v = split_heads(q), split_heads(k), split_heads(v)\r\n\u001b[93m 71 \r\n 72 \u001b[m    scale  = \u001b[95m1.0\u001b[m / math.sqrt(hd)\r\n\u001b[93m 73 \u001b[m    scores = torch.matmul(q, k.transpose(-\u001b[95m2\u001b[m, -\u001b[95m1\u001b[m)) * scale\r\n\u001b[93m 74 \u001b[m    probs  = F.softmax(scores, dim=-\u001b[95m1\u001b[m)\r\n\u001b[93m 75 \u001b[m    out    = torch.matmul(probs, v)\r\n\u001b[93m 76 \r\n 77 \u001b[m    \u001b[96m# merge heads →\u001b[29;24H output projection\u001b[m\r\n\u001b[93m 78 \u001b[m    out = out.permute(\u001b[95m0\u001b[m, \u001b[95m2\u001b[m, \u001b[95m1\u001b[m, \u001b[95m3\u001b[m).reshape(b * seq, num_frames, c)\r\n\u001b[93m 79 \u001b[m    out = F.linear(out, weights.to_out_weight, weights.to_out_bias)\r\n\u001b[93m 80 \r\n 81 \u001b[m    \u001b[96m# (b*seq, f, c) →\u001b[33;26H (b*f, seq, c)\u001b[m\r\n\u001b[93m 82 \u001b[m    out = out.view(b, seq, num_frames, c).permute(\u001b[95m0\u001b[m, \u001b[95m2\u001b[m, \u001b[95m1\u001b[m, \u001b[95m3\u001b[m).reshape(bf, seq, c)\r\n\u001b[93m 83 \u001b[m    \u001b[93mreturn"]
[75.053851, "o", "\u001b[m out\r\n\u001b[93m 84 \r\n 85 \r\n 86 \u001b[m\u001b[93mdef\u001b[m \u001b[1m\u001b[96msynthetic_weights\u001b[m(dim: \u001b[1m\u001b[96mint\u001b[m = \u001b[95m320\u001b[m, num_heads: \u001b[1m\u001b[96mint\u001b[m = \u001b[95m8\u001b[m) -> TemporalAttentionWeights:\r\n\u001b[93m 87 \u001b[m    \u001b[95m\"\"\"Random weights for testing —\u001b[39;40H same shapes as mm_sd_v15_v2.ckpt.\"\"\"\u001b[m\r\n\u001b[93m 88 \u001b[m    \u001b[93mdef\u001b[m \u001b[1m\u001b[96mw\u001b[m(rows, cols): \u001b[93mreturn\u001b[m torch.randn(rows, cols) * \u001b[95m0.02\u001b[m\r\n\u001b[93m 89 \u001b[m    \u001b[93mdef\u001b[m \u001b[1m\u001b[96mb\u001b[m(n):\u001b[10C\u001b[93mreturn\u001b[m torch.zeros(n)\r\n\u001b[93m 90 \u001b[m    \u001b[93mreturn\u001b[m TemporalAttentionWeights\u001b[46m(\u001b[m\r\n\u001b[93m 91 \u001b[m\u001b[8Cto_q_weight=w(dim, dim), to_q_bias=b(dim),\r\n\u001b[93m 92 \u001b[m\u001b[8Cto_k_weight=w(dim, dim), to_k_bias=b(dim),\r\n\u001b[93m 93 \u001b[m\u001b[8Cto_v_weight=w(dim, dim), to_v_bias=b(dim),\r\n\u001b[93m 94 \u001b[m\u001b[8Cto_out_weight=w(dim, dim), to_out_bias=b(dim),\r\n\u001b[93m 95 \u001b[m\u001b[8Cpos_encoding=sinusoidal_encoding(dim),\r\n\u001b[93m 96 \u001b[m\u001b[8Cdim=dim, num_heads=num_heads,\r\n\u001b[93m 97 \u001b[m    \u001b[46m)\u001b[m\u001b[50;203H97,5\u001b[10CBot\u001b[49;9H\u001b[?25h\u001b[?4m"]
