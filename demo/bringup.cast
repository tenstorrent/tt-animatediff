[41.314073, "o", "16:from einops import rearrange, repeat\r\n50:class VanillaTemporalModule(nn.Module):\r\n79:    def forward(self, input_tensor, temb, encoder_hidden_states, attention_mask=None, anchor_frame_idx=None):\r\n136:    def forward(self, hidden_states, encoder_hidden_states=None, attention_mask=None):\r\n138:        video_length = hidden_states.shape[2]\r\n139:        hidden_states = rearrange(hidden_states, \"b c f h w -> (b f) c h w\")\r\n151:            hidden_states = block(hidden_states, encoder_hidden_states=encoder_hidden_states, video_length=video_length)\r\n158:        output = rearrange(output, \"(b f) c h w -> b c f h w\", f=video_length)\r\n212:    def forward(self, hidden_states, encoder_hidden_states=None, attention_mask=None, video_length=None):\r\n218:                video_length=video_length,\r\n243:    def forward(self, x):\r\n272:    def forward(self, hidden_states, encoder_hidden_states=None, attention_mask=None, video_length=None):\r\n277:            hidden_states = rearrange(hidden_states, \"(b f) d c -> (b d) f c\", f=video_length)\r\n329:            hidden_states = rearrange(hidden_states, \"(b d) f c -> (b f) d c\", d=d)\r\n"]
